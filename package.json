{
	"name": "wp-storymap",
	"version": "0.1.0",
	"description": "Create Storymaps with an interactive OpenStreetMap map.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --blocks-manifest && wp-scripts build src/admin/point-editor.js src/admin/point-list.js --output-path=build/admin",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --blocks-manifest"
	},
	"dependencies": {
		"@wordpress/block-editor": "latest",
		"@wordpress/blocks": "latest",
		"@wordpress/components": "^42.0.0",
		"@wordpress/core-data": "^8.2.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/editor": "^15.2.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/i18n": "latest",
		"@wordpress/plugins": "^7.57.0",
		"leaflet": "^1.9.4",
		"maplibre-gl": "^6.14.0"
	},
	"devDependencies": {
		"@wordpress/scripts": "^35.0.0",
		"eslint": "^10.12.0"
	}
}
